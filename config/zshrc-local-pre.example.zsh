# Fragment facultatif : destination prévue ~/.zshrc.local.pre, à préparer soi-même.
# Chargé avant Homebrew, les valeurs par défaut et les intégrations.
# Ne pas lancer comme script ; tous les exemples sont désactivés.

# Choix personnels conservés par les valeurs par défaut du dépôt.
# export LANG='fr_CA.UTF-8'
# export EDITOR='vi'
# export VISUAL='vi'

# Palette Starship claire ; sombre par défaut. Ce choix n'interroge pas macOS.
# DOTFILES_APPARENCE=clair

# Une configuration Starship personnelle garde la priorité sur ce choix.
# export STARSHIP_CONFIG="$HOME/.config/mon-starship.toml"

# Fournir les options fzf avant sa préparation, si souhaité.
# export FZF_DEFAULT_OPTS='--height=50% --layout=reverse'

# Aucun secret et aucun chargement récursif de ~/.zshrc dans ce fichier.
